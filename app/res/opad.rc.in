// Windows resources of opad.exe: the logo (first icon = the one Explorer and the taskbar show) and version info.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/opad.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OPAD"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "opad"
      VALUE "OriginalFilename", "opad.exe"
      VALUE "ProductName", "OPAD"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
