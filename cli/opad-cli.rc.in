// Windows resources of opad-cli.exe: the logo and version info (with the copyright line opad.exe carries).
#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/app/res/opad.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OPAD command line"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "opad-cli"
      VALUE "LegalCopyright", "Copyright (c) 2026 Ahmad Amrey. MIT licence; third-party notices: opad-cli licenses."
      VALUE "OriginalFilename", "opad-cli.exe"
      VALUE "ProductName", "OPAD"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
