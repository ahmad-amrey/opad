{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows",
      "displayName": "Windows (MSYS2 MinGW-w64, pacman packages)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe"
      }
    },
    {
      "name": "windows-static",
      "displayName": "Windows single-file exe (MSYS2 qt6-static, OCCT built static once)",
      "inherits": "windows",
      "cacheVariables": {
        "OPAD_STATIC": "ON",
        "OPAD_STATIC_PREFIX": "C:/msys64/mingw64",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64/qt6-static;C:/msys64/mingw64",
        "OPAD_BUILD_PYTHON": "OFF",
        "OPAD_BUILD_PLUGINS": "OFF"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (distro packages)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos",
      "displayName": "macOS (Homebrew packages)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_PREFIX_PATH": "/opt/homebrew;/usr/local" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "windows-portable", "displayName": "Windows portable folder + zip (build/windows/portable)",
      "configurePreset": "windows", "targets": ["opad-portable"] },
    { "name": "windows-static", "configurePreset": "windows-static" },
    { "name": "windows-single", "displayName": "Windows single-file exe (build/windows-static/single)",
      "configurePreset": "windows-static", "targets": ["opad-single"] },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-single", "displayName": "Linux AppImage (build/linux/single)",
      "configurePreset": "linux", "targets": ["opad-single"] },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "macos-single", "displayName": "macOS app bundle + dmg (build/macos/single)",
      "configurePreset": "macos", "targets": ["opad-single"] }
  ],
  "testPresets": [
    { "name": "windows", "configurePreset": "windows", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "gui" } } },
    { "name": "windows-gui", "configurePreset": "windows", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "gui" } } },
    { "name": "windows-static", "configurePreset": "windows-static", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "gui" } } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "gui" } } },
    { "name": "macos", "configurePreset": "macos", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "gui" } } }
  ],
  "workflowPresets": [
    { "name": "windows", "steps": [
      { "type": "configure", "name": "windows" }, { "type": "build", "name": "windows" }, { "type": "test", "name": "windows" } ] },
    { "name": "windows-portable", "steps": [
      { "type": "configure", "name": "windows" }, { "type": "build", "name": "windows" }, { "type": "test", "name": "windows" },
      { "type": "build", "name": "windows-portable" } ] },
    { "name": "windows-single", "steps": [
      { "type": "configure", "name": "windows-static" }, { "type": "build", "name": "windows-static" }, { "type": "test", "name": "windows-static" },
      { "type": "build", "name": "windows-single" } ] },
    { "name": "linux", "steps": [
      { "type": "configure", "name": "linux" }, { "type": "build", "name": "linux" }, { "type": "test", "name": "linux" } ] },
    { "name": "linux-single", "steps": [
      { "type": "configure", "name": "linux" }, { "type": "build", "name": "linux" }, { "type": "test", "name": "linux" },
      { "type": "build", "name": "linux-single" } ] },
    { "name": "macos", "steps": [
      { "type": "configure", "name": "macos" }, { "type": "build", "name": "macos" }, { "type": "test", "name": "macos" } ] },
    { "name": "macos-single", "steps": [
      { "type": "configure", "name": "macos" }, { "type": "build", "name": "macos" }, { "type": "test", "name": "macos" },
      { "type": "build", "name": "macos-single" } ] }
  ]
}
